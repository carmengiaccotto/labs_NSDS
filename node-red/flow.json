    {
        "id": "7927ef26acacda89",
        "type": "function",
        "z": "7abd59c40768783c",
        "name": "Parser",
        "func": "let text = msg.payload.content;\nlet parts = text.split(\" \");\nlet command = parts[0].toUpperCase();\nlet city = parts[1];\nlet country = parts[2] || \"\";\n\nmsg.location = { city: city, country: country };\nmsg.chatId = msg.originalMessage.chat.id;\n\nif (command === \"QUERY\") {\n    return [msg, null, null];\n    \n} else if (command === \"TRACK\") {\n    return [null, msg, null];\n    \n} else if (command === \"REPORT\") {\n    return [null, null, msg];\n    \n} else {\n    return null; \n}",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 320,
        "wires": [
