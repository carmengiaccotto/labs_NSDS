        ]
    },
    {
        "id": "0f863fc93ca1562b",
        "type": "function",
        "z": "7abd59c40768783c",
        "name": "Save",
        "func": "let tracked = global.get('weatherUsers') || {};\nlet chatId = msg.chatId;\n\nif (!tracked[chatId]) tracked[chatId] = [];\n\ntracked[chatId].push(msg.location);\n\nglobal.set('weatherUsers', tracked);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
