    },
    {
        "id": "ad6dc53c2daa0502",
        "type": "function",
        "z": "7abd59c40768783c",
        "name": "Iterator",
        "func": "let tracked = global.get('weatherUsers') || {};\nlet chatId = msg.chatId;\nlet list = tracked[chatId];\n\nif (!list || list.length === 0) {\n    msg.payload = { content: \"No locations tracked.\" };\n    return [null]; \n}\n\nlet messages = [];\n\nfor (let i = 0; i < list.length; i++) {\n    let loc = list[i];\n    let newMsg =RED.util.cloneMessage(msg);\n    newMsg.location = { city: loc.city, country: loc.country };\n\n    newMsg.parts = {\n        id: msg._msgid,\n        index: i,\n        count: list.length,\n        type: 'array'\n    };\n\n    messages.push(newMsg);\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
